{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofiee-agent-validation.local/contracts/v1/task.input.schema.json",
  "title": "Validação — tarefa interna v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "objective", "stages"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "objective": { "type": "string", "minLength": 5, "maxLength": 4000 },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tool", "input"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$" },
          "tool": { "enum": ["validation.verifyClaim", "validation.auditSearchResults", "validation.inspectConsumerRuleBundle", "validation.applyConsumerRules"] },
          "input": { "type": "object" },
          "dependsOn": { "type": "array", "maxItems": 7, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$" } }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSteps": { "type": "integer", "minimum": 1, "maximum": 8 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 2 },
        "maxConcurrency": { "const": 1 },
        "maxDelegationDepth": { "const": 0 }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "taskId", "objectiveDigest", "completedStages"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "taskId": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
        "objectiveDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "completedStages": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "tool", "stageDigest", "result"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$" },
              "tool": { "enum": ["validation.verifyClaim", "validation.auditSearchResults", "validation.inspectConsumerRuleBundle", "validation.applyConsumerRules"] },
              "stageDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "result": { "type": "object" }
            }
          }
        }
      }
    }
  },
  "examples": {
    "validInput": {
      "contractVersion": "1.0.0",
      "objective": "Conferir uma afirmação de estudo sem fonte configurada",
      "stages": [
        {
          "id": "claim",
          "tool": "validation.verifyClaim",
          "input": {
            "contractVersion": "1.0.0",
            "claim": "Amostra sintética cobre a população declarada.",
            "dataType": "study_result",
            "context": "Fixture pública sintética.",
            "candidateReferences": [],
            "userFilters": []
          }
        }
      ]
    },
    "invalidInput": {
      "contractVersion": "1.0.0",
      "objective": "Tarefa sem etapas",
      "stages": []
    }
  }
}
